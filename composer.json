{
    "name": "makeabledk/laravel-translatable",
    "license": "CC-BY-SA-4.0",
    "autoload": {
        "psr-4": {
            "Makeable\\LaravelTranslatable\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Makeable\\LaravelTranslatable\\TranslatableServiceProvider"
            ],
            "aliases": {
                "Translations": "Makeable\\LaravelTranslatable\\Facades\\Translations"
            }
        }
    },
    "authors": [
        {
            "name": "Rasmus Christoffer Nielsen"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "13.*",
        "illuminate/support": "13.*"
    },
    "require-dev": {
        "laravel/laravel": "13.*",
        "makeabledk/laravel-factory-enhanced": "^6.0",
        "fakerphp/faker": "^1.19",
        "mockery/mockery": "^1.5",
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Makeable\\LaravelTranslatable\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit"
    }
}
